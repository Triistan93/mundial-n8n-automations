      "parameters": {
        "functionCode": "const input = $input.first().json;\n\n// Pre-send validation rule: dialog_type == 'private' AND dialog_id == requester_id\nconst requesterId = Number(input.requester_id || input.author_id);\nconst dialogId = String(requesterId);\n\nlet questionText = 'Gostaria de deixar algum comentário?';\nlet keyboardButtons = [\n  [{ text: 'Sim, quero comentar', command: 'Sim, quero comentar' }],\n  [{ text: 'Não, pode finalizar', command: 'Não, pode finalizar' }]\n];\n\nif (input.next_step === 'AWAITING_OPTIONAL_COMMENT_TEXT') {\n  questionText = 'Pode escrever agora. Seja breve e envie tudo em uma única mensagem.';\n  keyboardButtons = [];\n}\n\nreturn [{\n  json: {\n    deal_id: input.deal_id,\n    requester_id: requesterId,\n    dialog_id: dialogId,\n    message_text: questionText,\n    keyboard: keyboardButtons\n  }\n}];"
      },
      "name": "Format_Question_And_Buttons",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
