    {
      "parameters": {
        "functionCode": "const deal = $input.first().json.result || {};\n\n// Read-back verification\nconst impactVal = deal.UF_CRM_TI_IMPACT;\nconst urgencyVal = deal.UF_CRM_TI_URGENCY;\nconst priorityVal = deal.UF_CRM_TI_PRIORITY;\nconst nextOwnerVal = deal.UF_CRM_TI_NEXT_OWNER;\nconst waitReasonVal = deal.UF_CRM_TI_WAIT_REASON;\n\nconst isValid = Boolean(impactVal && urgencyVal && priorityVal && nextOwnerVal && waitReasonVal);\n\nreturn [{\n  json: {\n    deal_id: Number(deal.ID),\n    read_back_pass: isValid,\n    requester_id: Number(deal.CREATED_BY_ID || deal.UF_CRM_TI_REQUESTER),\n    summary_text: 'Triagem concluída com sucesso pela equipe de TI.'\n  }\n}];"
      },
      "name": "Validate_Read_Back",
