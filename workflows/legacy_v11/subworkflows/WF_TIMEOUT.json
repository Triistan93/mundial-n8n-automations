{
  "name": "WF_TIMEOUT",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [100, 300],
      "id": "node_start_timeout"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, deal_id, requester_user_id, last_interaction_at, EXTRACT(EPOCH FROM (NOW() - last_interaction_at)) / 3600 AS hours_inactive FROM ticket_bot_sessions WHERE status = 'ACTIVE';"
      },
      "name": "Query_Inactive_Sessions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [300, 300],
      "id": "node_query_inactive"
    },
    {
      "parameters": {
        "functionCode": "const sessions = $input.all().map(i => i.json);\nconst reminders = [];\nconst timeouts = [];\n\nfor (const s of sessions) {\n  const hours = Number(s.hours_inactive || 0);\n  if (hours >= 24) {\n    timeouts.push(s);\n  } else if (hours >= 4 && hours < 5) {\n    reminders.push(s);\n  }\n}\n\nreturn [{\n  json: {\n    reminders_count: reminders.length,\n    timeouts_count: timeouts.length,\n    reminders,\n    timeouts\n  }\n}];"
      },
      "name": "Evaluate_Timeouts",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [520, 300],
      "id": "node_eval_timeouts"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE ticket_bot_sessions SET status = 'TIMED_OUT', state = 'TIMED_OUT' WHERE deal_id = ANY($1::int[]);",
        "additionalFields": {
          "queryParams": "={{$node[\"Evaluate_Timeouts\"].json[\"timeouts\"].map(t => t.deal_id)}}"
        }
      },
      "name": "Update_Timed_Out_Sessions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [740, 300],
      "id": "node_update_timeouts"
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Query_Inactive_Sessions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query_Inactive_Sessions": {
      "main": [
        [
          {
            "node": "Evaluate_Timeouts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate_Timeouts": {
      "main": [
        [
          {
            "node": "Update_Timed_Out_Sessions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
